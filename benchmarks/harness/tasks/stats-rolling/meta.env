# stats-rolling — quality/discipline benchmark.
#
# Like vialite-todo (and unlike p24/p34) this task does NOT check out a pinned
# commit of an external repo: the starting tree is the self-contained skeleton
# shipped in this task dir (vendored montanaflynn/stats + 6 injected defects),
# and the harness seeds each rep by copying it. HIDDEN_DIR / DEFECTS live here
# and are never copied into the rep's worktree.
SEED_DIR=skeleton
HIDDEN_DIR=hidden
DEFECTS=defects.json
# ~3k LOC, single package, no deps, no network, no docker — a much smaller
# tree than vialite-todo (5400s). The work is one feature file plus an audit
# of ~120 files; 45min is generous for that and still bounds a wedged run.
TIMEOUT_S=2700
